<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!--
        The in-app WebView only ever connects to the local Syncthing GUI, and that connection is
        rewritten to the loopback interface before use (RootDestinations#toLoopback rewrites the URL
        to 127.0.0.1, mirroring ApiRequest#forceLoopbackHost for the REST API path). Trust
        user-installed CAs there so a user-supplied CA-signed HTTPS certificate validates natively,
        without weakening trust for any other (non-local) connection. The REST API connection is
        likewise loopback-pinned and already falls back to the OS trust store (SyncthingTrustManager),
        so user-CA trust is limited to loopback in the whole process. See
        https://github.com/researchxxl/syncthing-android/issues/222
    -->
    <domain-config>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
